# LearnX backend environment variables
# For Railway deployment, override DATABASE_URL with the Supabase PostgreSQL connection string.
# The backend reads all secrets from this file or from environment variables.

# --- App ---
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8443","https://learnx.vercel.app"]

# --- Database ---
# Production (Railway + Supabase PostgreSQL): replace with real connection string
DATABASE_URL=postgresql+psycopg://learnx:learnx@localhost:5432/learnx

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET_VIDEOS=learnx-videos
STORAGE_BUCKET_ORIGINALS=learnx-originals
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme
SIGNED_URL_TTL_SECONDS=900

# --- Auth ---
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
