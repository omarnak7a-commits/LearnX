# LearnX environment variables — copy to .env and fill in real values.
# NEVER commit real secrets. Values here are variable names only.
#
# See .env.deployment.secrets.md (gitignored) for the real values.

# --- Frontend (Vercel build-time) ---
# Backend API base URL (Render). Must be a full origin WITHOUT trailing slash,
# e.g. https://learnx-api.onrender.com — set in Vercel project env vars.
VITE_API_BASE_URL=https://learnx-api.onrender.com

# --- App (backend) ---
ENVIRONMENT=production
API_PREFIX=/api/v1
CORS_ORIGINS=["https://learn-x-ofvm.vercel.app"]

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# --- Redis / Celery (if used) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (Supabase Storage — S3-compatible) ---
STORAGE_BACKEND=s3
STORAGE_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=learnx-uploads
STORAGE_BUCKET_VIDEOS=learnx-uploads
STORAGE_BUCKET_ORIGINALS=learnx-uploads
STORAGE_ACCESS_KEY=<access-key>
STORAGE_SECRET_KEY=<secret-key>
SIGNED_URL_TTL_SECONDS=900

# --- Online AI (backend/server only — NEVER prefix these with VITE_) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Gemini 2.5 charges internal "thinking" tokens against maxOutputTokens and
# defaults to dynamic thinking, which can consume the whole budget and return
# an empty response. 0 disables thinking (correct for structured extraction).
# Range for 2.5 Flash is 0-24576; use -1 to omit the field and let the model
# decide (required for 2.5 Pro, which cannot disable thinking).
GEMINI_THINKING_BUDGET=0
GROQ_API_KEY=
# NOTE: llama-3.3-70b-versatile was shut down by Groq on 2026-08-16 and now
# returns HTTP 400 model_decommissioned. Check the Groq deprecations page
# before pinning a model here.
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
# Optional operational limits
AI_TIMEOUT_SECONDS=25
AI_MAX_DOCUMENT_BYTES=15728640
AI_MAX_DOCUMENT_CHARACTERS=100000

# --- Auth ---
JWT_SECRET=<random-hex>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM_ADDRESS="LearnX <onboarding@resend.dev>"

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=https://learn-x-ofvm.vercel.app/auth/callback/google
APP_BASE_URL=https://learn-x-ofvm.vercel.app
COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=true
