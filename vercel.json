{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python",
      "maxDuration": 60,
      "includeFiles": "backend/**"
    },
    "api/migrate.py": {
      "runtime": "@vercel/python",
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/api/migrate", "destination": "/api/migrate.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
